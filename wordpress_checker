#!/bin/bash

#############################################
# WordPress Checker - Refactored Functions #
#############################################

# ===== Global Variables =====
TARGET_USER=""
BOLD=""
RESET=""

# ===== Color Formatting =====
setup_colors() {
    if [ -t 1 ]; then
        BOLD="\033[1m"
        RESET="\033[0m"
    else
        BOLD=""
        RESET=""
    fi
}

# ===== Script Mode & Arguments =====
check_script_mode() {
    while getopts ":u:" opt; do
        case "$opt" in
            u)
                TARGET_USER="$OPTARG"
                ;;
            \?)
                echo "Usage: $0 [-u username]"
                exit 1
                ;;
            :)
                echo "Option -$OPTARG requires an argument."
                exit 1
                ;;
        esac
    done
}

# ===== Dependency Check =====
check_dependencies() {
    if ! command -v jq >/dev/null 2>&1; then
        printf '\njq is not installed. This script requires jq to process the plugin list.\n'
        exit 1
    fi
}

# ===== Control Panel Detection =====
detect_control_panel() {
    if [ -d /usr/local/cpanel ]; then
        echo "cpanel"
    elif [ -d /home/interworx ]; then
        echo "interworx"
    elif [ -d /usr/local/psa ]; then
        echo "plesk"
    else
        echo "unsupported"
    fi
}

# ===== WordPress Detection Functions =====
is_valid_wordpress_install() {
    local path="$1"
    
    # Check for essential WordPress directories and files
    if [ ! -f "$path/wp-config.php" ] ||
       [ ! -d "$path/wp-content" ] ||
       [ ! -d "$path/wp-includes" ]; then
        return 1
    fi
    return 0
}

# ===== Directory Scanning Functions =====
find_wordpress_sites() {
    local user="$1"
    local home="/home/$user"
    
    # Search for WordPress installations in common directories
    local search_dirs=(
        "$home/public_html"
        "$home/www"
        "$home/htdocs"
        "$home"
    )
    
    for search_dir in "${search_dirs[@]}"; do
        if [ ! -d "$search_dir" ]; then
            continue
        fi
        
        # Look for wp-config.php in this directory and subdirectories (max depth 2)
        find "$search_dir" -maxdepth 2 -type f -name "wp-config.php" 2>/dev/null | while read -r wp_config; do
            local path=$(dirname "$wp_config")
            if is_valid_wordpress_install "$path"; then
                echo "$path"
            fi
        done
    done
}

get_home_from_user() {
    local user="$1"
    getent passwd "$user" | awk -F: '{print $6}'
}

# ===== Site Information Functions =====
get_site_user_cpanel() {
    local site="$1"
    grep 'user:' /var/cpanel/userdata/*/"$site" 2>/dev/null | awk '{print $2}'
}

get_site_path_cpanel() {
    local site="$1"
    grep -R "^documentroot:" /var/cpanel/userdata/*/$site 2>/dev/null | awk '{print $2}'
}

get_site_info_plesk() {
    local site="$1"
    plesk db -BN -e "select name, login, www_root from domains join hosting on domains.id=hosting.dom_id join sys_users on hosting.sys_user_id=sys_users.id where name='${site}'" 2>/dev/null
}

get_plesk_wp_cli() {
    if [ -x /usr/local/psa/admin/bin/wp ]; then
        echo "/usr/local/psa/admin/bin/wp"
    else
        echo "/opt/plesk/php/7.4/bin/php -dmemory_limit=-1 /bin/wp"
    fi
}

get_cpanel_wp_cli() {
    echo "/opt/cpanel/ea-php81/root/usr/bin/php -dmemory_limit=-1 /usr/local/bin/wp"
}

# ===== System Information Functions =====
print_header() {
    local site="$1"
    local user="$2"
    local path="$3"
    
    printf '\n%s=============================================================\n' "$BOLD"
    printf 'Website : %s\n' "$site"
    printf 'User    : %s\n' "$user"
    printf 'Path    : %s\n' "$path"
    printf '=============================================================%s\n\n' "$RESET"
}

check_active_processes() {
    local user="$1"
    
    printf '%sActive Processes:%s\n' "$BOLD" "$RESET"
    local process=$(ps -u "$user" -U "$user" uf 2>/dev/null | sed '1d')
    if [ -z "$process" ]; then
        echo "No Active Processes Found"
    else
        echo "$process"
    fi
}

check_cron_jobs() {
    local user="$1"
    
    printf '\n%sCron Jobs:%s\n' "$BOLD" "$RESET"
    crontab -l -u "$user" 2>/dev/null || echo "No cron jobs found."
}

check_ssh_keys() {
    local home="$1"
    
    printf '\n%sSSH Keys:%s\n' "$BOLD" "$RESET"
    if [ -f "$home/.ssh/authorized_keys" ]; then
        local keys=$(grep -cv '^$' "$home/.ssh/authorized_keys" 2>/dev/null)
        if [ "$keys" -gt 0 ]; then
            echo "Found $keys SSH key(s)"
        else
            echo "authorized_keys exists but is empty."
        fi
    else
        echo "authorized_keys not found."
    fi
}

check_suspicious_directories() {
    local home="$1"
    
    printf '\n%sSuspicious Directories:%s\n' "$BOLD" "$RESET"
    [ -d "$home/.local" ] && ls -l "$home/.local/" 2>/dev/null
    [ -d "$home/.config" ] && ls -l "$home/.config/" 2>/dev/null
}

# ===== WordPress Check Functions =====
check_wordpress_url() {
    local path="$1"
    local wp_cli="$2"
    
    printf '%sWordPress URL:%s\n' "$BOLD" "$RESET"
    $wp_cli option get home --path="$path" --skip-plugins --skip-themes 2>/dev/null
}

check_wordpress_version() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sChecking WordPress Version%s\n' "$BOLD" "$RESET"
    local version_check=$($wp_cli core check-update --format=count 2>/dev/null)
    if [[ ${version_check:-0} -eq 0 ]]; then
        printf '\nWordPress core is at the latest version\n'
    else
        printf '\nWordPress core update available\n'
    fi
}

check_core_checksums() {
    local path="$1"
    local wp_cli="$2"
    
    local core=$($wp_cli core verify-checksums --path="$path" --skip-plugins --skip-themes 2>&1)
    printf '\n%sFiles Failed Checksum Verification:%s\n' "$BOLD" "$RESET"
    echo "$core" | awk '/doesn.t verify against checksum/ {print $7}' 2>/dev/null
    printf '\n%sUnexpected Files:%s\n' "$BOLD" "$RESET"
    echo "$core" | awk '/should not exist/ {print $6}' 2>/dev/null
}

check_plugin_checksums() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sPlugins Failed Checksum Verification:%s\n' "$BOLD" "$RESET"
    $wp_cli plugin verify-checksums --all --format=json --skip-plugins --skip-themes --path="$path" 2>/dev/null | jq -r '.[].plugin_name' 2>/dev/null | uniq
    
    printf '\n%sPlugins That Could Not Be Verified:%s\n' "$BOLD" "$RESET"
    $wp_cli plugin verify-checksums --all --skip-plugins --skip-themes --path="$path" 2>&1 | grep 'Could not retrieve the checksums' | awk '{print $12}' | tr -d ',' 2>/dev/null
}

check_outdated_plugins() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sOutdated Plugins:%s\n' "$BOLD" "$RESET"
    $wp_cli plugin list 2>/dev/null \
        --update=available \
        --path="$path" \
        --skip-plugins \
        --skip-themes
}

check_outdated_themes() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sOutdated Themes:%s\n' "$BOLD" "$RESET"
    $wp_cli theme list 2>/dev/null \
        --update=available \
        --path="$path" \
        --skip-plugins \
        --skip-themes
}

list_admin_users() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sAdministrator Accounts:%s\n' "$BOLD" "$RESET"
    $wp_cli user list 2>/dev/null \
        --role=administrator \
        --path="$path" \
        --skip-plugins \
        --skip-themes
}

check_admin_sessions() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sActive Admin Sessions:%s\n' "$BOLD" "$RESET"
    local ids=$($wp_cli user list \
        --role=administrator \
        --field=ID \
        --path="$path" \
        --skip-plugins \
        --skip-themes 2>/dev/null)
    
    for ID in $ids; do
        local display_name=$($wp_cli user get "$ID" \
            --field=display_name \
            --path="$path" \
            --skip-plugins \
            --skip-themes 2>/dev/null)
        
        printf '\n%sExisting sessions for administrator User:(%s)%s\n' "$BOLD" "$display_name" "$RESET"
        $wp_cli user session list "$ID" \
            --path="$path" \
            --skip-plugins \
            --skip-themes \
            --fields=login_time,ip 2>/dev/null
    done
}

reset_wordpress_salts() {
    local path="$1"
    local wp_cli="$2"
    
    printf '\n%sResetting WordPress Salts:%s\n' "$BOLD" "$RESET"
    $wp_cli config shuffle-salts \
        --path="$path" \
        --skip-plugins \
        --skip-themes 2>/dev/null
}

# ===== Main WordPress Check Function =====
perform_wordpress_checks() {
    local site_path="$1"
    local user="$2"
    local wp_cli="$3"
    
    # Extract site name from path for display
    local site=$(basename "$site_path")
    local home=$(get_home_from_user "$user")
    
    print_header "$site" "$user" "$site_path"
    
    check_active_processes "$user"
    check_cron_jobs "$user"
    check_ssh_keys "$home"
    check_suspicious_directories "$home"
    
    # Run WordPress checks as the target user
    sudo -u "$user" bash -c "
        $wp_cli option get home --path=\"$site_path\" --skip-plugins --skip-themes 2>/dev/null
        
        printf '\n${BOLD}Checking WordPress Version${RESET}\n'
        version_check=\$($wp_cli core check-update --format=count 2>/dev/null)
        if [[ \${version_check:-0} -eq 0 ]]; then
            printf '\nWordPress core is at the latest version\n'
        else
            printf '\nWordPress core update available\n'
        fi
        
        core=\$($wp_cli core verify-checksums --path=\"$site_path\" --skip-plugins --skip-themes 2>&1)
        printf '\n${BOLD}Files Failed Checksum Verification:${RESET}\n'
        echo \"\$core\" | awk '/doesn.t verify against checksum/ {print \$7}'
        printf '\n${BOLD}Unexpected Files:${RESET}\n'
        echo \"\$core\" | awk '/should not exist/ {print \$6}'
        
        printf '\n${BOLD}Plugins Failed Checksum Verification:${RESET}\n'
        $wp_cli plugin verify-checksums --all --format=json --skip-plugins --skip-themes --path=\"$site_path\" 2>/dev/null | jq -r '.[].plugin_name' | uniq
        
        printf '\n${BOLD}Plugins That Could Not Be Verified:${RESET}\n'
        $wp_cli plugin verify-checksums --all --skip-plugins --skip-themes --path=\"$site_path\" 2>&1 | grep 'Could not retrieve the checksums' | awk '{print \$12}' | tr -d ','
        
        printf '\n${BOLD}Outdated Plugins:${RESET}\n'
        $wp_cli plugin list 2>/dev/null --update=available --path=\"$site_path\" --skip-plugins --skip-themes
        
        printf '\n${BOLD}Outdated Themes:${RESET}\n'
        $wp_cli theme list 2>/dev/null --update=available --path=\"$site_path\" --skip-plugins --skip-themes
        
        printf '\n${BOLD}Administrator Accounts:${RESET}\n'
        $wp_cli user list 2>/dev/null --role=administrator --path=\"$site_path\" --skip-plugins --skip-themes
        
        printf '\n${BOLD}Active Admin Sessions:${RESET}\n'
        ids=\$($wp_cli user list --role=administrator --field=ID --path=\"$site_path\" --skip-plugins --skip-themes 2>/dev/null)
        for ID in \$ids; do
            display_name=\$($wp_cli user get \"\$ID\" --field=display_name --path=\"$site_path\" --skip-plugins --skip-themes 2>/dev/null)
            printf '\n${BOLD}Existing sessions for administrator User:(%s)${RESET}\n' \"\$display_name\"
            $wp_cli user session list \"\$ID\" --path=\"$site_path\" --skip-plugins --skip-themes --fields=login_time,ip 2>/dev/null
        done
        
        printf '\n${BOLD}Resetting WordPress Salts:${RESET}\n'
        $wp_cli config shuffle-salts --path=\"$site_path\" --skip-plugins --skip-themes 2>/dev/null
    "
}

# ===== Control Panel Handlers =====
handle_cpanel_sites() {
    local wp_cli=$(get_cpanel_wp_cli)
    
    # Get all cPanel users
    local users=$(cut -d: -f2 /etc/trueuserdomains)
    
    for user in $users; do
        # Respect -u filter
        if [ -n "$TARGET_USER" ] && [ "$user" != "$TARGET_USER" ]; then
            continue
        fi
        
        # Find WordPress installations for this user
        find_wordpress_sites "$user" | while read -r site_path; do
            perform_wordpress_checks "$site_path" "$user" "$wp_cli"
        done
    done
}

handle_plesk_sites() {
    local wp_cli=$(get_plesk_wp_cli)
    
    while IFS= read -r site; do
        [ -z "$site" ] && continue
        
        local initial_data=$(get_site_info_plesk "$site")
        local user=$(echo "$initial_data" | awk '{print $2}')
        
        if [ -z "$user" ]; then
            echo "Unable to determine user for $site"
            continue
        fi
        
        # Respect -u filter
        if [ -n "$TARGET_USER" ] && [ "$user" != "$TARGET_USER" ]; then
            continue
        fi
        
        local path=$(echo "$initial_data" | awk '{print $3}')
        
        if ! is_valid_wordpress_install "$path"; then
            continue
        fi
        
        perform_wordpress_checks "$path" "$user" "$wp_cli"
        
    done < <(plesk bin site -l 2>/dev/null)
}

handle_generic_scan() {
    local wp_cli=""
    
    # Determine PHP CLI based on control panel
    local cms=$(detect_control_panel)
    case "$cms" in
        cpanel)
            wp_cli=$(get_cpanel_wp_cli)
            ;;
        plesk)
            wp_cli=$(get_plesk_wp_cli)
            ;;
        *)
            # Fall back to system wp-cli
            wp_cli="wp"
            ;;
    esac
    
    # If -u is specified, scan only that user
    if [ -n "$TARGET_USER" ]; then
        if ! id "$TARGET_USER" >/dev/null 2>&1; then
            echo "Error: User $TARGET_USER does not exist"
            exit 1
        fi
        
        find_wordpress_sites "$TARGET_USER" | while read -r site_path; do
            perform_wordpress_checks "$site_path" "$TARGET_USER" "$wp_cli"
        done
    else
        # Scan all users
        local users=$(cut -d: -f1 /etc/passwd | grep -v '^root$' | grep -v '^_' | grep -v '^nobody$')
        
        for user in $users; do
            # Skip system users
            if [ "$user" = "mysql" ] || [ "$user" = "postgres" ] || [ "$user" = "apache" ] || [ "$user" = "nginx" ]; then
                continue
            fi
            
            find_wordpress_sites "$user" 2>/dev/null | while read -r site_path; do
                perform_wordpress_checks "$site_path" "$user" "$wp_cli"
            done
        done
    fi
}

# ===== Main Execution =====
main() {
    setup_colors
    check_dependencies
    check_script_mode "$@"
    
    local cms=$(detect_control_panel)
    
    case "$cms" in
        cpanel)
            handle_cpanel_sites
            ;;
        plesk)
            handle_plesk_sites
            ;;
        *)
            # Generic scanning for unsupported control panels
            handle_generic_scan
            ;;
    esac
}

main "$@"
